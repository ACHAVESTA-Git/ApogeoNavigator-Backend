# Variables de entorno del backend. Copia a .env (que no se versiona) y ajusta. Nunca pongas secretos reales aquí.

# --- CORS ---
# Orígenes permitidos, separados por comas (sin «*»). Por defecto: localhost:5173 y 127.0.0.1:5173.
# El dominio de producción queda vacío hasta que exista (se compra en GoDaddy).
CORS_ORIGINS=http://localhost:5173
# Previsualizaciones de Cloudflare Pages del proyecto «apogeo-navigator»:
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?apogeo-navigator\.pages\.dev$
