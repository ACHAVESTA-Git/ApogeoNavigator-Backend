# Variables de entorno del backend.
# Copia este archivo a .env (que no se versiona) y ajusta. NUNCA pongas aquí secretos reales: en producción los secretos
# van en el gestor de secretos del despliegue (Secret Manager) y se inyectan como variables de entorno.
# «Obligatoria en producción» = con K_SERVICE definido (Cloud Run) o ENVIRONMENT=production, si falta el arranque o la
# operación falla cerrada.

# --- Entorno ---
PORT=8080
# Marca producción además de K_SERVICE (que Cloud Run define solo). No lo definas en local.
ENVIRONMENT=
# Carpeta con los CSV (sites.csv, efemerides_<site_id>.csv, metricas.csv) y el manifiesto firmado.
DATA_DIR=data

# --- Datos en Cloud Storage ---
# Obligatorio en producción (el disco de Cloud Run es efímero); en desarrollo déjalo vacío para usar DATA_DIR.
DATA_BUCKET=
# Carpeta dentro del bucket (opcional).
DATA_BUCKET_PREFIX=
# Semilla de datos: se copia al bucket solo si está vacío (la imagen Docker la trae en /srv/seed-data).
DATA_SEED_DIR=
# Cada cuántos segundos comprueban las lecturas si el bucket cambió.
DATA_REFRESH_SECONDS=30

# --- CORS ---
# Orígenes permitidos, separados por comas (no admite «*»). Por defecto: localhost:5173 y 127.0.0.1:5173.
# El dominio de producción queda vacío hasta que exista (se compra en GoDaddy).
CORS_ORIGINS=http://localhost:5173
# Previsualizaciones de Cloudflare Pages del proyecto «apogeo-navigator»:
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?apogeo-navigator\.pages\.dev$

# --- Límite de consultas en vivo (/api/horizons) ---
# Proxies de confianza delante de la app. El límite por cliente usa la entrada de X-Forwarded-For que está esta cantidad
# de posiciones desde el final (el principio lo puede falsear el cliente). Cloud Run directo: 1 (por defecto).
TRUSTED_PROXY_HOPS=1

# --- Claves de acceso a la API (X-API-Key) ---
# Carga de CSV (/api/datos/**) y consulta de la auditoría (/api/auditoria/**). Vacía = carga cerrada (siempre 401).
UPLOAD_API_KEY=
# Gestor de claves por usuario (/api/admin/**). Distinta de UPLOAD_API_KEY.
ADMIN_API_KEY=

# --- Base de datos y auditoría ---
# Vacía = base de datos y auditoría desactivadas (en producción: la carga responde 503).
# Local (docker compose):  postgresql+psycopg://apogeo:apogeo_dev@postgres:5432/apogeo
# Cloud Run + Cloud SQL:   postgresql+psycopg://APP_USER:CLAVE@/apogeo?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATABASE_URL=
# Sal del HMAC de la IP (nunca se guarda la IP en claro). Obligatoria en producción con base de datos.
IP_HASH_SALT=
# 1 = un evento de auditoría que no se pueda firmar no se registra (en producción ya es así).
AUDIT_REQUIRE_SIGNATURE=

# --- Firma post-cuántica ML-DSA-65 (manifiesto firmado, auditoría y cargas) ---
# Obligatorias en producción. Genéralas con: python scripts/pqc/generar_claves.py
# Sin ellas, en desarrollo se genera un par local en PQC_DEV_KEY_DIR (no sirve para producción).
PQC_PRIVATE_KEY=
PQC_PUBLIC_KEY=
PQC_DEV_KEY_DIR=

# --- Cifrado del email de usuarios (ML-KEM-1024) ---
# Obligatorias en producción. Genéralas con: python scripts/pqc/generar_claves.py --servidor
# Perder PQC_KEM_PRIVATE_KEY (y sus anteriores) deja los emails irrecuperables: guarda versiones del secreto.
PQC_KEM_PRIVATE_KEY=
PQC_KEM_PUBLIC_KEY=
EMAIL_HASH_KEY=
# Solo durante una rotación de claves (separadas por comas); retíralas cuando rotar_cifrado() devuelva 0 y 0.
PQC_KEM_PRIVATE_KEY_ANTERIORES=
EMAIL_HASH_KEY_ANTERIORES=

# --- Logs ---
# Formato de la consola del backend: texto (legible) o json (Cloud Run / Cloud Logging) y nivel mínimo.
LOG_FORMAT=texto
LOG_LEVEL=INFO
